{
  "name": "poetainos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write resources/js/",
    "format:check": "prettier --check resources/js/",
    "types:check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "translate": "php artisan translatable:export es",
    "translate-check": "php artisan translatable:inspect-translations es"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@inertiajs/vite": "^3.7.1",
    "@inertiajs/vue3": "^3.7.0",
    "@khmyznikov/pwa-install": "^0.6.4",
    "@prettier/plugin-php": "^0.25.0",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.0.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.13.2",
    "crop-url": "^4.0.1",
    "date-fns": "^4.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^14.0.0",
    "jsdom": "^30.0.1",
    "laravel-echo": "^2.0.6",
    "laravel-vite-plugin": "^3.2.0",
    "linkify-html": "^4.1.3",
    "linkify-plugin-mention": "^4.1.3",
    "linkifyjs": "^4.1.3",
    "lodash-es": "^4.17.21",
    "markdown-it": "^15.0.1",
    "millify": "^6.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "pusher-js": "^8.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.10",
    "vue-tsc": "^3.3.11",
    "vuetify": "^4.0.0",
    "workbox-build": "^7.3.0"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/karla": "^5.3.0"
  }
}
