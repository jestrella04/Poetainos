{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "cyberwizard/dbsafeguard": "dev-main",
    "guzzlehttp/guzzle": "^7.2",
    "inertiajs/inertia-laravel": "^3.0",
    "intervention/image-laravel": "^1.3",
    "laravel-notification-channels/facebook-poster": "^6.2.0",
    "laravel-notification-channels/twitter": "^8.0",
    "laravel-notification-channels/webpush": "^10.3.0",
    "laravel/framework": "^12.0",
    "laravel/passport": "^13.0",
    "laravel/reverb": "^1.0",
    "laravel/sanctum": "^4.0",
    "laravel/socialite": "^5.0",
    "laravel/tinker": "^2.7",
    "mews/captcha": "^3.3",
    "pusher/pusher-php-server": "^7.0",
    "spatie/image-optimizer": "^1.7",
    "spatie/laravel-ignition": "^2.0",
    "spatie/laravel-sitemap": "^7.0",
    "staudenmeir/laravel-adjacency-list": "^1.5",
    "tightenco/ziggy": "^2.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9.1",
    "kkomelin/laravel-translatable-string-exporter": "^1.10",
    "laravel/boost": "^2.7",
    "laravel/breeze": "^2.0",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.0.1",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^8.1",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "phpunit/phpunit": "^11.0",
    "rector/rector": "^2.6",
    "spatie/laravel-ignition": "^2.3"
  },
  "autoload": {
    "files": [
      "app/Helpers/Helper.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=0.0.0.0 --port=8000\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
    ],
    "preview": [
      "Composer\\Config::disableProcessTimeout",
      "npm run build",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=0.0.0.0 --port=8000\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run preview\" --names=server,queue,logs,vite --kill-others"
    ],
    "remote": [
      "Composer\\Config::disableProcessTimeout",
      "npm run build",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#f4f0ff\" \"php artisan serve --host=0.0.0.0 --port=8000\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run preview\" \"ssh -t -R 80:localhost:8000 proxy.tunnl.gg\" --names=server,queue,logs,vite,remote --kill-others"
    ],
    "ci:check": [
      "Composer\\Config::disableProcessTimeout",
      "pint --parallel --test",
      "@analyse",
      "npm run lint:check",
      "npm run format:check",
      "npm run types:check",
      "npm run test"
    ],
    "analyse": [
      "phpstan analyse --memory-limit=1G"
    ],
    "ci:format": [
      "rector process",
      "pint --parallel",
      "npx prettier --write resources/",
      "npm run lint"
    ],
    "ci:update": [
      "npm update",
      "composer update"
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ],
    "test:db:up": [
      "docker compose -f docker-compose.testing.yml up -d --wait"
    ],
    "test:db:down": [
      "docker compose -f docker-compose.testing.yml down"
    ],
    "test:ci": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan config:clear --ansi",
      "@php artisan test",
      "npm run test"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  }
}
